    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Ignace Philippe Nyamagana Butera",
            "email": "nyamsprod@gmail.com"
        },
        {
            "name": "Tim Düsterhus",
            "email": "tim@tideways-gmbh.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": { "Symfony\\Polyfill\\Time\\": "" },
        "classmap": [ "Resources/stubs" ]
    },
    "minimum-stability": "dev",
    "extra": {
        "thanks": {
